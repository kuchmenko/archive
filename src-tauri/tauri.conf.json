{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Archive",
  "version": "0.1.0",
  "identifier": "dev.kuchmenko.archive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Archive",
        "width": 960,
        "height": 720,
        "minWidth": 540,
        "minHeight": 420,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
